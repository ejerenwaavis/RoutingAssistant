<!doctype html>
<html lang="en" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Sign In · Routing Assistant</title>
  <link rel="icon" href="https://triumphcourier.com/img/Logo-SVG.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col justify-center items-center p-4 antialiased font-sans">

  <div class="w-full max-w-md">
    <!-- Brand Header -->
    <div className="text-center mb-8 flex flex-col items-center">
      <div class="h-12 w-12 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center text-white shadow-xl shadow-emerald-950/50 mb-3 mx-auto">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
          <circle cx="12" cy="10" r="3" />
        </svg>
      </div>
      <h1 class="text-xl font-bold tracking-tight text-zinc-100 text-center">Routing Assistant</h1>
      <p class="text-xs text-zinc-400 mt-1 text-center">Sign in to access your dispatch workspace</p>
    </div>

    <!-- Auth Card -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 sm:p-8 shadow-2xl shadow-black/60">
      <% if (body.message) { %>
        <div class="mb-4 p-3 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs rounded-xl flex items-center gap-2">
          <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          <span><%= body.message %></span>
        </div>
      <% } else if (body.error) { %>
        <div class="mb-4 p-3 bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs rounded-xl flex items-center gap-2">
          <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          <span><%= body.error %></span>
        </div>
      <% } %>

      <!-- Google Sign In -->
      <a href="<%= body.domain %>/auth/google" class="w-full py-2.5 px-4 bg-zinc-800 hover:bg-zinc-750 hover:border-zinc-600 border border-zinc-700/80 rounded-xl text-zinc-200 font-medium text-xs flex items-center justify-center gap-3 transition-all shadow-sm">
        <svg class="h-4 w-4" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span>Sign in with Google</span>
      </a>

      <!-- Divider -->
      <div class="relative my-5">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-zinc-800"></div>
        </div>
        <div class="relative flex justify-center text-[11px] uppercase tracking-wider">
          <span class="bg-zinc-900 px-2 text-zinc-500">or sign in with email</span>
        </div>
      </div>

      <!-- Local Form -->
      <form action="<%= body.domain %>/login" method="post" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-zinc-300 mb-1.5" for="username">Email Address</label>
          <input
            type="email"
            id="username"
            name="username"
            required
            value="<%= (login) ? login : '' %>"
            placeholder="driver@example.com"
            class="w-full bg-zinc-950/80 border border-zinc-800 rounded-xl px-3.5 py-2 text-xs text-zinc-100 placeholder:text-zinc-600 focus:outline-none focus:border-emerald-500/60 focus:ring-1 focus:ring-emerald-500/40"
          >
        </div>

        <div>
          <label class="block text-xs font-medium text-zinc-300 mb-1.5" for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            placeholder="••••••••"
            class="w-full bg-zinc-950/80 border border-zinc-800 rounded-xl px-3.5 py-2 text-xs text-zinc-100 placeholder:text-zinc-600 focus:outline-none focus:border-emerald-500/60 focus:ring-1 focus:ring-emerald-500/40"
          >
        </div>

        <button
          type="submit"
          class="w-full py-2.5 px-4 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-medium text-xs rounded-xl shadow-lg shadow-emerald-950/50 transition-all cursor-pointer"
        >
          Sign In
        </button>
      </form>

      <div class="mt-6 text-center text-xs text-zinc-400">
        Don't have an account?
        <a href="<%= body.domain %>/register" class="text-emerald-400 hover:text-emerald-300 font-medium ml-1">Create an account</a>
      </div>
    </div>

    <!-- Footer -->
    <p class="mt-6 text-center text-xs text-zinc-600">
      &copy; <%= new Date().getFullYear() %> Routing Assistant · ACED DevOps & Logistics
    </p>
  </div>

</body>
</html>